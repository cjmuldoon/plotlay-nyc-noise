	partition Districts = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/community_districts.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"cd", "district", "borough", "reports_a_week", "reports_2025", "night_share", "busiest_hour", "busiest_hour_reports"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"cd", Int64.Type}, {"district", type text}, {"borough", type text}, {"reports_a_week", type number}, {"reports_2025", Int64.Type}, {"night_share", type number}, {"busiest_hour", type text}, {"busiest_hour_reports", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
