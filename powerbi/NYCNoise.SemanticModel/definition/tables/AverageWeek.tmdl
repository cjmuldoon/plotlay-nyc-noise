table AverageWeek
	lineageTag: 4be85965-97af-2c56-398a-51125c638391

	/// Reports in an average week (the hours in view)
	measure 'Reports a week' = SUM ( AverageWeek[reports_a_week] )
		formatString: #,0
		lineageTag: 6a27aec9-9b49-eaf7-c5bc-3c51f14bc6ae

	/// The heat map classes: under 30, 30 to 60, 60 to 120, 120 to 240, 240 or more
	measure 'Heat colour' =
			VAR v = SUM ( AverageWeek[reports_a_week] )
			RETURN SWITCH ( TRUE (), v < 30, "#fff7d6", v < 60, "#ffeda0", v < 120, "#feb24c", v < 240, "#f03b20", "#bd0026" )
		lineageTag: 6dbd25df-d9a5-90b8-ac99-047518a6873d

	column hour_of_week
		dataType: string
		lineageTag: 1fc2adcd-1a68-dc08-56a5-93f1a5a5d565
		summarizeBy: none
		sourceColumn: hour_of_week

		annotation SummarizationSetBy = Automatic

	column weekday
